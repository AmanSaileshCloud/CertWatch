# Local development settings. Copy to `.env` (git-ignored) and fill in values.
# Real environment variables always win over this file.

# ── PostgreSQL (docker compose) ──────────────────────────────────────────────
POSTGRES_DB=certwatch
POSTGRES_USER=certwatch
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ── App storage ──────────────────────────────────────────────────────────────
STORAGE=postgres
# Same credentials as above. Inside docker compose the host is `postgres`.
DATABASE_URL=postgresql://certwatch:<POSTGRES_PASSWORD>@localhost:5432/certwatch
# Only used by the automated tests (a throwaway database).
TEST_DATABASE_URL=postgresql://certwatch:<POSTGRES_PASSWORD>@localhost:5432/certwatch_test
# Legacy SQLite file — the source for scripts/migrate_sqlite_to_postgres.py.
SQLITE_PATH=certwatch.db

# ── Uptime worker (python -m backend.runner.run_uptime) ─────────────────────
UPTIME_TICK_SECONDS=10
UPTIME_MAX_CONCURRENCY=50
UPTIME_USER_AGENT=CertWatch-Uptime/1.0
UPTIME_REGION=default
UPTIME_MAX_BODY_BYTES=1000000
# Failed checks in a row before a monitor is DOWN (opens an incident)
UPTIME_FAILURE_THRESHOLD=3
# Successful checks in a row before a DOWN monitor is UP again (closes the incident)
UPTIME_RECOVERY_THRESHOLD=1
# Allow monitoring private/internal addresses (localhost, 10.x, 192.168.x, cloud metadata). Keep false unless needed.
UPTIME_ALLOW_PRIVATE_TARGETS=false
# Repeat a "still down" email every N minutes while a site stays down: 0 (never), 15, 30, 60, 120
UPTIME_REMINDER_MINUTES=30
# Only email once a site has been down this many minutes: 0 (at once), 5, 10, 15, 30
UPTIME_ALERT_DELAY_MINUTES=0
# Dashboard URL for the "View in CertWatch" link in alert emails (e.g. https://certwatch.example.com)
CERTWATCH_PUBLIC_URL=

# ── Alerts ───────────────────────────────────────────────────────────────────
NOTIFIER=console
# NOTIFIER=sns_ses
# AWS_REGION=us-east-1
# SNS_TOPIC_ARN=
# ALERT_EMAIL=
# ALERT_RECIPIENTS=
# Fernet key that encrypts the SES SMTP password saved on the admin Settings page.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret and never commit it. If it is lost or changed, the saved SMTP
# password can no longer be read — re-enter it on the Settings page.
SETTINGS_ENCRYPTION_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_ENABLED=true
# Generate with: openssl rand -hex 32
AUTH_SECRET=
AUTH_BOOTSTRAP_PASSWORD=
