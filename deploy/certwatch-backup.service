[Unit]
Description=CERTWatch nightly database backup (local + optional S3)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=certwatch
Group=certwatch
WorkingDirectory=/opt/certwatch/app
EnvironmentFile=/etc/certwatch/certwatch.env
ExecStart=/bin/bash /opt/certwatch/app/deploy/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/certwatch/backups
