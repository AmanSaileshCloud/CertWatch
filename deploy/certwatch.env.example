# ─────────────────────────────────────────────────────────────────────────────
# CERTWatch production environment — single EC2 t2.micro.
# Copy to /etc/certwatch/certwatch.env and fill in the CHANGE_ME values.
# Loaded by both the API service and the checker timer (systemd EnvironmentFile).
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage: single-file SQLite on the box ──────────────────────────────────
BACKEND=aws
STORAGE=sqlite
SQLITE_PATH=/opt/certwatch/data/certwatch.db

# ── Alerts: AWS SNS + SES (per manager) ──────────────────────────────────────
# Credentials come from the EC2 IAM instance role — do NOT put AWS keys here.
# Leave AWS_ENDPOINT_URL empty so boto3 resolves real AWS endpoints.
NOTIFIER=sns_ses
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:CHANGE_ME_ACCOUNT_ID:ssl-alerts
# ALERT_EMAIL is the SES sender ("From") and the primary recipient.
ALERT_EMAIL=alerts@yourcompany.com
# Optional extra recipients (comma-separated). ALERT_EMAIL is always included.
# In the SES sandbox, every address here must be a verified identity.
# ALERT_RECIPIENTS=ops@yourcompany.com,oncall@yourcompany.com

# ── Checker behaviour ─────────────────────────────────────────────────────────
THRESHOLD_DAYS=30,14,7,1
TLS_TIMEOUT_SECONDS=10
# Hours an agent-managed domain may go without a report before the checker
# treats its agent as down and alerts once. The agent's default interval is
# 5 minutes, so 6h tolerates a restart without paging.
AGENT_STALE_AFTER_HOURS=6
# Private-domain transport: the checker invokes AWS-RunShellScript on each
# record's agent_id (an SSM managed-instance ID). No CertWatch agent is needed.
AGENT_TRANSPORT=ssm
SSM_DOCUMENT_NAME=AWS-RunShellScript
SSM_POLL_INTERVAL_SECONDS=2

# ── Auth: username/password JWT (self-contained) ──────────────────────────────
AUTH_ENABLED=true
# deploy/setup.sh replaces both CHANGE_ME values below with generated secrets
# when it first creates /etc/certwatch/certwatch.env. If you write this file by
# hand, generate them yourself:  openssl rand -hex 32
#
# These placeholders are published in this repo, so they are NOT secrets. With
# AUTH_ENABLED=true the API refuses to start while either still contains
# "CHANGE_ME" (or is under 32 chars) — anyone holding the signing key can forge
# an admin token, so it fails loudly rather than serving wide open.
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_32_CHARS_MINIMUM
AUTH_TOKEN_EXPIRE_MINUTES=720
AUTH_USERS_FILE=/opt/certwatch/data/auth_users.json
# Password for the auto-seeded 'admin' user on first run (change after logging in).
AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Uptime monitoring worker (certwatch-uptime.service) ─────────────────────
# How often the worker looks for due monitors, and how many sites it checks at once.
UPTIME_TICK_SECONDS=10
UPTIME_MAX_CONCURRENCY=50
# Sent with every check — customers can allow-list it in their WAF.
UPTIME_USER_AGENT=CertWatch-Uptime/1.0
# Label stamped on each result (multi-region checks later).
UPTIME_REGION=default
# Bytes of a page read for the keyword check.
UPTIME_MAX_BODY_BYTES=1000000
# Failed checks in a row before a monitor is DOWN (opens an incident).
UPTIME_FAILURE_THRESHOLD=3
# Successful checks in a row before a DOWN monitor is UP again (closes the incident).
UPTIME_RECOVERY_THRESHOLD=1

# ── Report ──────────────────────────────────────────────────────────────────
# The admin "Download Report" button generates a PDF status report on demand —
# no email/SMTP configuration is required.

# ── CORS: empty — the frontend is same-origin behind Nginx ───────────────────
CORS_ORIGINS=
