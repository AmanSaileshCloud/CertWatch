[Unit]
Description=CERTWatch uptime rollup — hourly summaries + delete raw results past retention
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=certwatch
Group=certwatch
WorkingDirectory=/opt/certwatch/app
EnvironmentFile=/etc/certwatch/certwatch.env
ExecStart=/opt/certwatch/venv/bin/python -m backend.runner.run_rollup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/certwatch/data
